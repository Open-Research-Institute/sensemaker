{
  "name": "qrx",
  "version": "26.06.16",
  "type": "module",
  "description": "hyperprompting REPL that fits in a qrcode",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "build": "vite build",
    "build:github": "GITHUB_PAGES=true node servers/github/build.js && GITHUB_PAGES=true vite build",
    "postbuild": "npm run tree",
    "tree": "npx tree-cli --ignore \".git,node_modules,public,data,dist\" -o docs/llm/tree.txt"
  },
  "dependencies": {
    "html-minifier-terser": "^7.2.0",
    "qrcode": "^1.5.4",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "express": "^4.18.0",
    "tree-cli": "^0.6.7",
    "vite-plugin-pwa": "^1.2.0"
  }
}
